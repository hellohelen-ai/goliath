{
  "name": "goliath-example",
  "version": "0.0.0",
  "private": true,
  "description": "A Goliath turn running on the phone's own model. Needs a development build on an iOS 26 device.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "bundle": "expo export --platform ios --output-dir .expo-export"
  },
  "dependencies": {
    "@hellohelen-ai/goliath": "^0.0.3",
    "@react-native-ai/apple": "^0.12.0",
    "ai": "^7.0.91",
    "expo": "^54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-linking": "~8.0.12",
    "expo-router": "^6.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo-doctor": "^1.20.4",
    "typescript": "~5.9.2"
  }
}
