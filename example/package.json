{
  "name": "goliath-example",
  "version": "0.0.0",
  "private": true,
  "description": "A Goliath turn using Apple Intelligence, with live lifecycle hooks. Needs an iOS 26 development build.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "doctor": "expo-doctor",
    "bundle": "expo export --platform ios --output-dir .expo-export"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@hellohelen-ai/goliath": "file:..",
    "@react-native-ai/apple": "^0.12.0",
    "ai": "^7.0.91",
    "expo": "^54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "^6.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "zod": "^4.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo-doctor": "^1.20.4",
    "react-native-svg-transformer": "1.5.3",
    "typescript": "~5.9.2"
  }
}
